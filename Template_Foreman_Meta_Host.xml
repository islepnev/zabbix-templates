                    <name>Foreman hosts - status code map</name>
                    <type>DEPENDENT</type>
                    <key>foreman_api_hosts_status_code_map</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.results</parameter>
                            </parameters>
                        </step>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>m = {};
JSON.parse(value).forEach(function(element) {k=element.configuration_status; if (m[k]) m[k]++; else m[k]=1;});
return JSON.stringify(m);</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>foreman_api[hosts]</key>
                    </master_item>
